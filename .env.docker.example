# Copy to .env, change SESSION_SECRET + ADMIN_PASS, then `docker compose up -d`.
# See docker-compose.yml for the full list of overridable variables.

HOST_PORT=3000

ADMIN_USER=admin
ADMIN_PASS=changeme
SESSION_SECRET=replace-me-with-64-random-hex-chars

PUBLIC_BASE_URL=http://localhost:3000
APP_DEBUG=false

# SQLite (default). Data persists in the uptime-data volume.
DB_DRIVER=sqlite

# To use MySQL instead, switch DB_DRIVER and start the mysql profile:
#   docker compose --profile mysql up -d
# DB_DRIVER=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=uptime
# DB_PASSWORD=replace-me
# DB_NAME=uptime

# Whitelabel (optional)
# APP_NAME=My Uptime
# FOOTER_TEXT=Owned by Acme Corp
# FOOTER_LINK=https://acme.example

# --- OIDC single sign-on (optional) ---
# Generic OpenID Connect login (PocketID, Authelia, Authentik, Keycloak, …).
# Enabled when OIDC_ISSUER and OIDC_CLIENT_ID are set. Register this redirect
# URI with your provider: ${PUBLIC_BASE_URL}/login/oidc/callback
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only).
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email groups
# OIDC_BUTTON_LABEL=Sign in with SSO
# Access from the groups claim: each role gets a group name, * (any user the
# provider authenticates) or empty/none (never granted through SSO). The
# highest matching role wins and is re-synced on every SSO login; users in no
# configured group are refused. At least one must be set.
# OIDC_GROUPS_CLAIM=groups
# OIDC_ADMIN_GROUP=uptime-admins
# OIDC_EDITOR_GROUP=uptime-editors
# OIDC_VIEWER_GROUP=uptime-viewers
# Create a local account on first SSO login (otherwise only pre-linked users).
# OIDC_AUTO_CREATE=true
# SSO-only: the login page goes straight to the provider. The env super-admin
# can still sign in at /login?local=1; requires a non-default ADMIN_PASS.
# OIDC_DISABLE_PASSWORD_LOGIN=false
# Allow a plain-http OIDC_ISSUER (e.g. Docker-internal). Refused otherwise.
# OIDC_ALLOW_HTTP_ISSUER=false
